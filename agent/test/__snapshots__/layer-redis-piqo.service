# /etc/systemd/system/layer-redis-piqo.service
# Generated by layer-agent. Manage it in the panel.
[Unit]
Description=Redis for piqo
After=network.target

[Service]
Type=simple
User=app-piqo
Group=app-piqo
# systemd opens the config (root 600) and hands it over on stdin: the
# password never sits in a file the app's user can read.
StandardInput=file:/etc/layer/apps/piqo/redis.conf
StandardOutput=journal
ExecStart=/usr/bin/redis-server -
Restart=on-failure
RestartSec=2
SyslogIdentifier=app-piqo-redis
UMask=0077

# Resources
MemoryHigh=102M
MemoryMax=128M
CPUQuota=100%
TasksMax=256
LimitNOFILE=65536

# Sandbox
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/piqo/data/redis
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
PrivateIPC=yes
# Nothing an app needs, and a way in for one that's compromised: the system
# D-Bus, and the cloud's metadata service (169.254.169.254 at Hetzner, AWS…).
InaccessiblePaths=-/run/dbus
IPAddressDeny=169.254.0.0/16
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
