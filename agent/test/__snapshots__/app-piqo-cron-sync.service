# /etc/systemd/system/app-piqo-cron-sync.service
# Generated by layer-agent. Manage crons in the panel.
[Unit]
Description=layer cron piqo/sync

[Service]
Type=oneshot
User=app-piqo
Group=app-piqo
WorkingDirectory=/srv/apps/piqo/current/apps/web
Environment=DATA_DIR=/srv/apps/piqo/data
EnvironmentFile=-/etc/layer/apps/piqo/services.env
EnvironmentFile=/etc/layer/apps/piqo/app.env
Environment=PATH=/opt/layer/node/24.13.1/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/opt/layer/node/24.13.1/bin/node scripts/sync.js
TimeoutStartSec=600
SyslogIdentifier=app-piqo-cron-sync
UMask=0077

# Resources
MemoryHigh=204M
MemoryMax=256M
CPUQuota=100%
TasksMax=256
LimitNOFILE=65536

# Sandbox
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/apps/piqo/data
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
PrivateIPC=yes
# Nothing an app needs, and a way in for one that's compromised: the system
# D-Bus, and the cloud's metadata service (169.254.169.254 at Hetzner, AWS…).
InaccessiblePaths=-/run/dbus
IPAddressDeny=169.254.0.0/16
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
