# layer: slug=site live=static
# Generated by layer-agent. Run `layer repair` instead of editing.
site.example.com {
	encode zstd gzip
	root * /srv/static/site/current
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
	try_files {path} {path}/ /index.html
	file_server
	log {
		output file /var/log/caddy/site.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
