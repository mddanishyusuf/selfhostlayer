# layer: slug=hello live=green port=4001
# Generated by layer-agent. Run `layer repair` instead of editing.
hello.com, www.hello.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:4001 {
		# Retry briefly instead of failing while an upstream restarts.
		lb_try_duration 5s
	}
	log {
		output file /var/log/caddy/hello.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
